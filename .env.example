# Copier ce fichier en ".env" puis remplir les valeurs.
# Ne JAMAIS mettre le fichier .env sur GitHub (il est dans le .gitignore).

# --- Option 1 (conseillée) : modèle ouvert en local avec Ollama ---
# installer Ollama puis : ollama pull qwen2.5:7b
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama

# --- Option 2 : API Groq (gratuite, plus rapide sur un PC sans GPU) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
# LLM_API_KEY=ta_cle_groq_ici

# --- Option 3 : API Mistral ---
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MODEL=mistral-small-latest
# LLM_API_KEY=ta_cle_mistral_ici

LLM_TEMPERATURE=0.2

# modèle d'embeddings (téléchargé automatiquement au premier lancement)
MODELE_EMBEDDINGS=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# similarité minimale pour répondre (sinon abstention)
SEUIL_ABSTENTION=0.35
